EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Phone apps: where to download the daily product catalog (your website address + /catalog.json)
EXPO_PUBLIC_CATALOG_URL=https://YOUR-SITE.netlify.app/catalog.json

# PrintingIQ's WhatsApp number for vendors (the whatsapp-bot function), international digits, e.g. 9647509912525.
# When set, "Add many products" shows "Send photos on WhatsApp".
EXPO_PUBLIC_WHATSAPP_BOT=
